```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Dependencies
.venv/
venv/
*.egg-info/
dist/
build/

# Coverage
.coverage
coverage/
htmlcov/

# MyPy
.mypy_cache/

# PyTest
.pytest_cache/
```